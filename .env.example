# Salin file ini menjadi .env lalu isi dengan nilai rahasia Anda sendiri.
# File .env otomatis diabaikan oleh .gitignore dan tidak akan terunggah ke GitHub.

ADMIN_USER=admin
ADMIN_PASS=GantiDenganPasswordKuatAnda#2026
SESSION_SECRET=
ALLOWED_ORIGINS=
# Set TRUST_PROXY=1 hanya jika aplikasi berada di belakang Nginx / Caddy / Cloudflare Tunnel
TRUST_PROXY=0
# Set ENABLE_DEMO_TOOLS=true hanya untuk testing/simulasi lokal
ENABLE_DEMO_TOOLS=false
